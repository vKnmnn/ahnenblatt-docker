# Registry name is optional for local builds; use lowercase for GHCR.
IMAGE=ghcr.io/vknmnn/ahnenblatt-docker
SERIES=2.99
# Persistent application settings and Wine profile.
CONFIG_DIR=./data/2.99
# Optional existing folder containing .ahn files and their media directories.
# Defaults to CONFIG_DIR/files when unset.
# DATA_DIR=/path/to/your/ahnenblatt-data
HTTP_PORT=3000
HTTPS_PORT=3001
# Entire container locale, including language, dates and number formats.
LC_ALL=en_US.UTF-8
PUID=1000
PGID=1000
# Or uncomment the /etc/localtime mount in Compose and use TZ=:/etc/localtime.
TZ=Europe/Berlin
# Optional HTTP basic authentication provided by the base image.
CUSTOM_USER=abc
PASSWORD=

# Runtime controls for optional Selkies panels (true/false).
SELKIES_UI_SIDEBAR_SHOW_STATS=false
SELKIES_UI_SIDEBAR_SHOW_VIDEO_SETTINGS=false
SELKIES_UI_SIDEBAR_SHOW_SCREEN_SETTINGS=false
# Enable both values to allow sharing and show its controls.
SELKIES_UI_SIDEBAR_SHOW_SHARING=false
SELKIES_ENABLE_SHARING=false|locked
