# Registry name is optional for local builds; use lowercase for GHCR.
IMAGE=ghcr.io/vknmnn/ahnenblatt-docker
SERIES=5
# Separate from the existing ./config installation.
CONFIG_DIR=./data/5
HTTP_PORT=3000
HTTPS_PORT=3001
# Initial Wine/desktop locale; choose the application language inside Ahnenblatt.
APP_LOCALE=en_US.UTF-8
PUID=1000
PGID=1000
TZ=Europe/Berlin
# Optional HTTP basic authentication provided by the base image.
CUSTOM_USER=abc
PASSWORD=
